# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a GitHub.
APP_ENV=local
# En desarrollo true muestra el tipo de error en las respuestas; en producción debe ser false.
APP_DEBUG=true

# Usa 127.0.0.1 (no "localhost") para evitar demoras por IPv6 en Windows.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventario_sd
DB_USER=inventario_app
DB_PASS=

# Orígenes del navegador autorizados (separados por coma). Debe coincidir exacto con la URL de React.
ALLOWED_ORIGINS=http://localhost:5173

# true solo cuando el sitio se sirva por HTTPS. auto detecta HTTPS (no recomendado detrás de proxys).
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800